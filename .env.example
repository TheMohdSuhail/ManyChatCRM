# Neon Postgres (`npx neon@latest init` ya Neon Console -> Connect se)
# Pooled URL (host me "-pooler") -> app queries
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct URL -> prisma db push / migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ManyChat -> Settings -> API -> Generate your API Key
MANYCHAT_API_TOKEN=""

# ManyChat External Request ke header "x-webhook-secret" me yahi value daalni hai
WEBHOOK_SECRET="change-me-long-random-string"

# CRM login
CRM_PASSWORD="admin123"
AUTH_SECRET="change-me-another-long-random-string"

# true karoge to CRM me status badalne par ManyChat subscriber pe tag lagega (crm_converted, crm_lost...)
MANYCHAT_SYNC_STATUS_TAGS="false"

# Setup page par webhook URL dikhane ke liye (deploy ke baad apna domain)
APP_URL="http://localhost:3000"
