// Database: Neon Postgres.
// DATABASE_URL = pooled (app queries), DATABASE_URL_UNPOOLED = direct (prisma db push / migrations)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Lead {
  id                String     @id @default(cuid())
  subscriberId      String     @unique // ManyChat subscriber id
  pageId            String?
  name              String?
  firstName         String?
  lastName          String?
  igUsername        String?
  igId              String?
  email             String?
  phone             String?
  profilePic        String?
  gender            String?
  locale            String?
  timezone          String?
  lastInputText     String? // user ka last message / comment
  liveChatUrl       String?
  source            String? // kis automation/keyword/post se lead aayi
  status            String     @default("NEW")
  dealValue         Float?
  followUpAt        DateTime?
  tags              String     @default("[]") // JSON array of tag names
  customFields      String     @default("{}") // JSON object { fieldName: value }
  rawPayload        String? // last webhook body (debugging ke liye)
  subscribedAt      DateTime?
  lastInteractionAt DateTime?
  lastWebhookAt     DateTime? // last kab aayi — ManyChat webhook ya Instagram DM (returning lead bhi upar dikhe)
  igConversationId  String? // Instagram DM conversation id (Instagram import se)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  notes             Note[]
  activities        Activity[]
  messages          Message[]

  @@index([status])
  @@index([createdAt])
  @@index([lastWebhookAt])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // CREATED | WEBHOOK | STATUS | SYNC | UPDATE
  message   String
  createdAt DateTime @default(now())
}

// Instagram DM messages (Instagram Conversations API se import)
model Message {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  igMessageId String   @unique
  fromMe      Boolean // true = humne (Herbal Maza account ne) bheja
  text        String?
  sentAt      DateTime
  createdAt   DateTime @default(now())

  @@index([leadId, sentAt])
}

// CRM login users. role: ADMIN (users manage kar sakta hai) | MEMBER
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           String    @default("MEMBER")
  sessionVersion Int       @default(1) // badhane par us user ke saare sessions logout
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Chhoti settings (Instagram token, last sync time...)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
